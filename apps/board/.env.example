# Public, client-safe identity
NEXT_PUBLIC_SITE_URL=https://board.pgpz.org

# Required private-portal controls. Membership is decided by the allowlist only;
# an empty or missing allowlist locks every account out (safe default).
BOARD_MEMBER_EMAILS=director1@example.org,director2@example.org
# Administrators must also appear in BOARD_MEMBER_EMAILS.
BOARD_ADMIN_EMAILS=director1@example.org
# Optional staff roster: the Executive Director gains portal access and
# administrator privileges without joining the Board. Must be disjoint from
# BOARD_MEMBER_EMAILS; an overlapping address fails configuration.
BOARD_EXECUTIVE_DIRECTOR_EMAILS=executive.director@example.org
# Optional staff roster: Legal Counsel gains the same admin-equivalent portal
# privileges as admins and the Executive Director (document management and
# audit review). Must be pairwise disjoint from BOARD_MEMBER_EMAILS and
# BOARD_EXECUTIVE_DIRECTOR_EMAILS; overlapping addresses fail configuration.
BOARD_LEGAL_COUNSEL_EMAILS=legal.counsel@example.org

# Governance infrastructure (emitted by the PgpzBoardBackend stack outputs).
# The document vault and audit ledger are no-ops / fail-closed while unset.
BOARD_DOCUMENTS_TABLE=PGPZBoardDocuments
BOARD_AUDIT_TABLE=PGPZBoardAuditLog
BOARD_ACCESS_TABLE=PGPZBoardAccess
# Enable only after the guarded roster migration is clean and complete. When
# true, the registry is authoritative and missing/deactivated records fail closed.
BOARD_ACCESS_REGISTRY_ENABLED=false
BOARD_DOCUMENTS_STAGING_BUCKET=
BOARD_DOCUMENTS_RETAINED_BUCKET=
BOARD_AUDIT_ARCHIVE_BUCKET=
BOARD_KMS_KEY_ID=

# Authentication (must stay isolated to this application's own table)
NEXTAUTH_TABLE=PGPZBoardNextAuth
REGION_AWS=us-east-1
BETTER_AUTH_URL=https://board.pgpz.org
BETTER_AUTH_TRUSTED_ORIGINS=https://board.pgpz.org
BETTER_AUTH_SECRET=replace-with-a-board-only-secret-at-least-32-characters

# Passwordless rollout. Leave password auth enabled until every active user has
# completed a passwordless sign-in; disable it only during the guarded cutover.
BOARD_PASSWORDLESS_AUTH_ENABLED=true
BOARD_PASSWORD_AUTH_ENABLED=true

# Production magic-link delivery must use the dedicated Board SES identity and
# the Amplify compute role (no static SMTP credentials in production).
EMAIL_TRANSPORT=ses
EMAIL_FROM=PGPZ Board <board@pgpz.org>
